# === OpenTofu / Terraform =====================================================
# Tofu-Arbeitsverzeichnis (überall regenerierbar)
**/.terraform/

# Lockfile NUR in Modulen ignorieren – die im Root-Modul wird bewusst committet
infra/modules/**/.terraform.lock.hcl

*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan-Dateien: enthalten ALLE Variablenwerte im Klartext – inklusive der
# Secrets, die mise via `_.file = secrets.sops.yaml` als Env injiziert.
*.tfplan
tfplan
plan.out

# === Secrets - NIEMALS committen ==============================================
# tfvars mit Werten (nur *.example wird eingecheckt)
*.tfvars
*.tfvars.json
!*.tfvars.example

# SOPS: die ENTSCHLUESSELTEN Klartext-Dateien (die *.enc.* / *.sops.* bleiben drin)
*.dec
*.decrypted
*.plaintext

# age / SSH private keys
# key*.txt deckt keys.txt ab (SOPS-Standardpfad), age*.txt die mise-Variante
*.agekey
*.age
key*.txt
age*.txt
*.pem
*.key
id_rsa
id_ed25519

# kubeconfig (enthaelt Cluster-Credentials)
kubeconfig
*.kubeconfig
.kube/

# lokale Env-Overrides (mise.local.toml, direnv, ...)
.env
.envrc
*.local.toml

# === Kram =====================================================================
.DS_Store
*.swp
*~
